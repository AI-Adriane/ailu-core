{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@ailu/graph-core": [
        "packages/graph-core/src/index.ts"
      ],
      "@ailu/graph-runtime": [
        "packages/graph-runtime/src/index.ts"
      ],
      "@ailu/graph-sdk": [
        "packages/graph-sdk/src/index.ts"
      ],
      "@ailu/agents-core": [
        "packages/agents-core/src/index.ts"
      ],
      "@ailu/llm-gateway": [
        "packages/llm-gateway/src/index.ts"
      ],
      "@ailu/artifact-store": [
        "packages/artifact-store/src/index.ts"
      ],
      "@ailu/approval-engine": [
        "packages/approval-engine/src/index.ts"
      ],
      "@ailu/observability": [
        "packages/observability/src/index.ts"
      ],
      "@ailu/lang-ailu": [
        "packages/lang-ailu/src/index.ts"
      ],
      "@ailu/graph-ailu": [
        "packages/graph-ailu/src/index.ts"
      ],
      "@ailu/cli": [
        "packages/ailu-cli/src/cli.ts"
      ],
      "@ailu/contracts": [
        "packages/contracts/src/index.ts"
      ],
      "@ailu/model-core": [
        "packages/model-core/src/index.ts"
      ],
      "@ailu/model-openai": [
        "packages/model-openai/src/index.ts"
      ],
      "@ailu/model-anthropic": [
        "packages/model-anthropic/src/index.ts"
      ],
      "@ailu/model-gemini": [
        "packages/model-gemini/src/index.ts"
      ],
      "@ailu/model-mistral": [
        "packages/model-mistral/src/index.ts"
      ],
      "@ailu/okf": [
        "packages/okf/src/index.ts"
      ],
      "@ailu/knowledge": [
        "packages/knowledge/src/index.ts"
      ],
      "@ailu/search": [
        "packages/search/src/index.ts"
      ],
      "@ailu/memory-store": [
        "packages/memory-store/src/index.ts"
