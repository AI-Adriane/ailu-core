          "runId": "run-1",
          "timestamp": "0",
          "nodeId": "send"
        },
        {
          "type": "node_failed",
          "runId": "run-1",
          "timestamp": "0",
          "nodeId": "send",
          "error": "503",
          "attempt": 1,
          "category": "transient"
        },
        {
          "type": "run_failed",
          "runId": "run-1",
          "timestamp": "0",
          "error": "send failed after retries"
        }
      ]
    },
    "expected": {
      "runId": "run-1",
      "status": "failed",
      "currentNode": "send",
