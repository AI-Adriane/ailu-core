  {
    "name": "tools waiting for approval, sorted, once each, strings only",
    "kind": "explain",
    "input": {
      "state": {
        "runId": "run-1",
        "graphId": "g",
        "currentNodeId": "assistant",
        "status": "suspended",
        "channels": {
          "__suspend": {
            "reason": "interrupt"
          },
          "agentResult": {
            "approvalRequests": [
              {
                "subject": "tool:wire",
                "reason": "needs approval"
              },
              {
                "subject": "tool:refund",
                "reason": "needs approval"
              },
              {
                "subject": "tool:refund",
                "reason": "needs approval"
              },
              {
                "subject": "gate:x",
                "reason": "needs approval"
              },
              {
                "subject": {
                  "description": "tool:y"
                },
                "reason": "needs approval"
              },
              {
                "subject": 5,
                "reason": "needs approval"
              }
            ]
          },
          "other": {
            "approvalRequests": [
              {
                "subject": "tool:alpha",
                "reason": "needs approval"
              }
            ]
          },
          "text": "tool:not-a-request",
          "list": [
            {
              "approvalRequests": [
                {
                  "subject": "tool:in-a-list",
                  "reason": "needs approval"
                }
              ]
            }
          ],
          "nothing": null
        },
        "version": 4,
        "checkpointId": "run-1:4",
        "createdAt": "0",
        "updatedAt": "0"
      }
    },
    "expected": {
      "runId": "run-1",
      "status": "suspended",
      "currentNode": "assistant",
      "summary": "Suspended at \"assistant\" (interrupt). To continue: a human approves the \"alpha\", \"refund\", \"wire\" tool call, then call app.approveAndResume(runId, { approvedTools: [\"alpha\", \"refund\", \"wire\"], resolvedBy }).",
      "channels": [
        "agentResult",
        "list",
        "nothing",
        "other",
        "text"
      ],
      "suspended": {
        "reason": "interrupt",
        "node": "assistant",
        "nextAction": "a human approves the \"alpha\", \"refund\", \"wire\" tool call, then call app.approveAndResume(runId, { approvedTools: [\"alpha\", \"refund\", \"wire\"], resolvedBy })"
      }
    }
  },
