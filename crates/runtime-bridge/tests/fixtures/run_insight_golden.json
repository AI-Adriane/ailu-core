      "recentEvents": [
        {
          "type": "node_started",
          "node": "send"
        },
        {
          "type": "node_failed",
          "node": "send"
        },
        {
          "type": "run_failed"
        }
      ],
      "failure": {
        "error": "send failed after retries"
      }
    }
  },
