        "data": {
          "embedding": [
            1
          ]
        }
      },
      "expected": {
        "error": "createEmbeddings: malformed embeddings response: `data` is not an array"
      }
    },
    {
      "name": "an entry without embedding",
      "response": {
        "data": [
          {
            "embedding": [
              1
            ]
          },
          {
            "vector": [
              2
            ]
          }
        ]
      },
      "expected": {
        "error": "createEmbeddings: malformed embeddings response: `data[1].embedding` is not a number[]"
      }
    },
    {
      "name": "a non-number in an embedding",
      "response": {
        "data": [
          {
            "embedding": [
              1,
              "2"
            ]
          }
        ]
      },
      "expected": {
        "error": "createEmbeddings: malformed embeddings response: `data[0].embedding` is not a number[]"
