        "model": "text-embedding-3-large",
        "dimensions": 256
      },
      "texts": [
        "x"
      ],
      "expected": {
        "model": "text-embedding-3-large",
        "input": [
          "x"
        ],
        "dimensions": 256
      }
    },
    {
      "name": "no texts: no call",
      "options": {},
      "texts": [],
      "expected": null
    }
  ],
  "responses": [
    {
      "name": "two vectors",
