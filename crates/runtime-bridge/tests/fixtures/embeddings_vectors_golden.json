{
  "bodies": [
    {
      "name": "mistral defaults",
      "options": {},
      "texts": [
        "a",
        "b"
      ],
      "expected": {
        "model": "mistral-embed",
        "input": [
          "a",
          "b"
        ]
      }
    },
    {
      "name": "openai defaults",
      "options": {
        "provider": "openai"
      },
      "texts": [
        "x"
      ],
      "expected": {
        "model": "text-embedding-3-small",
        "input": [
          "x"
        ]
      }
    },
    {
      "name": "a model and dimensions",
      "options": {
